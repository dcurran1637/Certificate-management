PORT=5000
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=certapp_app
DB_PASSWORD=REPLACE_WITH_ROTATED_RANDOM_PASSWORD
DB_NAME=certificate_management
# Required for remote production databases; path to the trusted CA certificate.
DB_SSL_CA=
# Set these before first startup; use this email and password to sign in.
BOOTSTRAP_ADMIN_NAME=Your Name
BOOTSTRAP_ADMIN_EMAIL=you@example.com
# Replace with a unique password of at least 12 characters and save it securely.
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_YOUR_UNIQUE_PASSWORD

SESSION_SECRET=CHANGE_ME_to_a_long_random_string
UPLOAD_DIR=/var/lib/certapp/uploads
EXPIRING_THRESHOLD_DAYS=60 